{
  "name": "网页实时翻译",
  "description": "选中文本后点击右下角小点，使用阿里云翻译或本地引擎翻译",
  "version": "1.1.1",
  "manifest_version": 3,
  "default_locale": "zh_CN",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://api.fanyi.baidu.com/*",
    "https://mt.cn-hangzhou.aliyuncs.com/*",
    "https://manga18.club/*",
    "https://cdn.manga18.club/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["scripts/translator.js", "scripts/content.js", "scripts/selection-trigger.js", "scripts/content-simple.js", "scripts/sidebar-translator.js", "scripts/manga-page.js"],
      "css": ["styles/sidebar-button.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["styles/*.css", "scripts/*.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
